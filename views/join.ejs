<main class="page-main">
<div class="container-sm">
    <div class="text-center">
      <h1 class="page-heading" style="margin-top:10px">Join your simulation</h1>
      <p class="page-subtitle">Enter the session code provided by your instructor to continue.</p>
    </div>
    <section class="card join-card" aria-labelledby="join-title">
      <div class="card-body">
        <form id="join-form" novalidate>
          <div class="form-group">
            <label class="form-label" for="session-code">Session code</label>
            <input class="form-control" pattern="[A-Z0-9]{6}" id="session-code" name="session-code" placeholder="e.g. ABC123" autocomplete="off" autocapitalize="characters" required aria-describedby="code-hint join-error">
            <div class="form-hint" id="code-hint">Your instructor will provide this code.</div>
          </div>
          <div id="join-error" class="notice notice-error hidden" role="alert" style="margin-bottom:14px">Please enter a session code.</div>
          <button class="btn btn-primary btn-block" type="submit">Join Session <svg style="height:2em;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <div class="creation-prompt"><a class="inline-link" href="/createsim">Set-up Simulation <svg style="height:1.5em;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </div>
    </section>
  </div>
</main>