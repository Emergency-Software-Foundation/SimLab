<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Join a Simulation · eSimLab</title><link rel="stylesheet" href="design-system.css">
</head>
<body>
<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="." aria-label="SimLab home"><span style="background-color:black;" class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-6.5 11A1.3 1.3 0 0 0 4.6 22h14.8a1.3 1.3 0 0 0 1.1-2L14 9V3"/><path d="M7 17h10M9 14h2"/></svg></span><span>eSimLab</span></a>
  </div>
</header>
<main class="page-main">
  <div class="container-sm">
    <div class="text-center">
      <h1 class="page-heading" style="margin-top:10px">Join your simulation</h1>
      <p class="page-subtitle">Enter the session code provided by your instructor to continue.</p>
    </div>
    <section class="card join-card" aria-labelledby="join-title">
      <div class="card-body">
        <form id="join-form" novalidate>
          <div class="form-group">
            <label class="form-label" for="session-code">Session code</label>
            <input class="form-control" pattern="[A-Z0-9]{6}" id="session-code" name="session-code" placeholder="e.g. ABC123" autocomplete="off" autocapitalize="characters" required aria-describedby="code-hint join-error">
            <div class="form-hint" id="code-hint">Your instructor will provide this code.</div>
          </div>
          <div id="join-error" class="notice notice-error hidden" role="alert" style="margin-bottom:14px">Please enter a session code.</div>
          <button class="btn btn-primary btn-block" type="submit">Join Session <svg style="height:2em;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <div class="creation-prompt"><a class="inline-link" href="create-simulation.html">Create Simulation <svg style="height:1.5em;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </div>
    </section>
  </div>
</main>
<footer class="footer"><div class="container footer-inner"><span>ESF eSimLab <span aria-hidden="true">·</span> (c) Emergency Software Foundation <span id="copyright-year">2026</span></span> <span style="float:right;"><a href="#">Privacy Policy</a> <span aria-hidden="true">·</span> <a href="#">Terms of Service</a> <span aria-hidden="true">·</span> <a href="#">Acknowledgements</a> <span aria-hidden="true">·</span> <a href="https://github.com/Emergency-Software-Foundation/SimLab">Contribute</a></span></div></footer>
<script src="app.js"></script>
</body></html>