<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= (typeof pageTitle !== 'undefined')?(pageTitle+" · "):"" %>eSimLab</title><link rel="stylesheet" href="design-system.css">
</head>
<body>
<header class="topbar">
  <div class="container topbar-inner">
    <a class="brand" href="/" aria-label="SimLab home"><span style="background-color:black;" class="brand-mark"><svg viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v6l-6.5 11A1.3 1.3 0 0 0 4.6 22h14.8a1.3 1.3 0 0 0 1.1-2L14 9V3"/><path d="M7 17h10M9 14h2"/></svg></span><span>eSimLab</span></a>
    <% if (typeof session !== 'undefined' && session?.user?.sid) { %>
    <div class="row">
      <span class="badge badge-blue">
        Session: <%= session?.user?.sid %><%= (typeof simTitle !== 'undefined')?(" | "+simTitle):"" %>
      </span>
      <a class="nav-link" href="/logout">Exit</a>
    </div>
    <% } %>
  </div>
</header>